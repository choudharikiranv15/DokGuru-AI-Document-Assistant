# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
rag_env/
venv/
.env/

# Environment variables and secrets
.env
.env.production
backend/.env.production
config/.env
env.yaml
backend/env.yaml

# Node modules (frontend dependencies)
node_modules/
frontend/node_modules/

# Build outputs
frontend/dist/
frontend/build/

# Data files
/data/
!data/pdfs/  # Allow the folder, but not its contents
!data/processed/
backend/data/  # Ignore backend runtime data (audio cache, chroma_db, etc.)
*.sqlite3

# Model files
/models/
!models/README.md

# Streamlit cache
.streamlit/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test database
/test_chroma_db/

# Ignore test outputs
*.out

# Misc
*.bak
*.swp
nul

# Claude Code configuration
.claude/

# Sample/test files
img/
test_*.py
list_*.py
verify_*.py

# Project documents
DocuMind_Voice_Final_Project_Summary.pdf

# Documentation (keeping only README.md public)
docs/
DEPLOYMENT_GUIDE.md
INTEGRATION_STATUS.md
IMPLEMENTATION_PLAN.md
*.md
!README.md

# Allow source code and config templates
!src/
!config/config.py
!requirements.txt
!setup.py
