# Cloud Run Environment Variables
# IMPORTANT: Replace placeholder values with your actual keys
# Usage: gcloud run services update dokguru-backend --region asia-south1 --env-vars-file env.yaml

# ======================
# REQUIRED - LLM & AI
# ======================
GROQ_API_KEY: "your_groq_api_key_here"
GEMINI_API_KEY: "your_gemini_api_key_here"

# ======================
# REQUIRED - DATABASE
# ======================
SUPABASE_URL: "https://your-project.supabase.co"
SUPABASE_KEY: "your_supabase_anon_key_here"
DATABASE_URL: "postgresql://user:password@host:port/database"
SUPABASE_JWT_SECRET: "your_supabase_jwt_secret_here"

# ======================
# REQUIRED - SECURITY
# ======================
SECRET_KEY: "your_secret_key_minimum_32_chars"

# ======================
# LLM FALLBACKS
# ======================
SAMBANOVA_API_KEY: "your_sambanova_api_key_here"
OPENROUTER_API_KEY: "your_openrouter_api_key_here"
HUGGINGFACE_API_TOKEN: "your_huggingface_token_here"
OPENAI_API_KEY: "your_openai_api_key_here"

# ======================
# MODEL CONFIGURATION
# ======================
EMBEDDING_MODEL: "all-MiniLM-L6-v2"
LLM_MODEL: "llama3-8b-8192"
GEMINI_VISION_MODEL: "gemini-1.5-flash"

# ======================
# VECTOR DATABASE
# ======================
VECTOR_DB_PATH: "./data/chroma_db"
COLLECTION_NAME: "pdf_documents"
CHUNK_SIZE: "1000"
CHUNK_OVERLAP: "200"
TOP_K_RESULTS: "5"

# ======================
# REDIS CACHING
# ======================
REDIS_URL: "redis://default:password@host:port"
UPSTASH_REDIS_REST_URL: "https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN: "your_upstash_token_here"
QUERY_CACHE_TTL: "3600"
SESSION_TTL: "86400"
RATE_LIMIT_MAX: "50"
RATE_LIMIT_WINDOW: "3600"

# ======================
# TTS SETTINGS
# ======================
TTS_SPEED_MULTIPLIER: "1.75"

# ======================
# MONITORING
# ======================
SENTRY_DSN: "your_sentry_dsn_here"
SENTRY_ENVIRONMENT: "production"
POSTHOG_API_KEY: "your_posthog_api_key_here"

# ======================
# EMAIL SERVICE
# ======================
RESEND_API_KEY: "your_resend_api_key_here"
FROM_EMAIL: "noreply@yourdomain.com"

# ======================
# FRONTEND / CORS
# ======================
FRONTEND_URL: "https://yourdomain.com"
CORS_ORIGINS: "https://yourdomain.com,https://www.yourdomain.com,http://localhost:5173,http://localhost:3000"
