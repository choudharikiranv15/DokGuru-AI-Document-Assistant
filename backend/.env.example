# ======================
# PRO TIER LLM API KEYS (Best models, for paid users)
# ======================

# Groq (Primary) - Ultra-fast inference, 6K TPM
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cerebras - Ultra-fast, 1M tokens/day FREE!
# Get from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Google Gemini - 1M context window, 250K TPM free
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# DeepSeek - NO rate limits, very cheap ($0.14/M tokens)
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Mistral - High quality European models, free tier
# Get from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# ======================
# FREE TIER LLM API KEYS (Fallbacks for free users)
# ======================

# SambaNova - Good free tier, Llama 3.1 models
# Get from: https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# OpenRouter - Aggregator with FREE models (Llama, Mistral, etc.)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cohere - Trial tier, 5K gen units/month, great for RAG
# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Hugging Face - FREE forever, rate limited
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# ======================
# OTHER API KEYS
# ======================

# OpenAI (for Whisper STT - optional)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini (legacy - use GOOGLE_API_KEY instead)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=llama3-8b-8192
GEMINI_VISION_MODEL=gemini-1.5-flash

# ======================
# DATABASE CONFIGURATION
# ======================
# Supabase PostgreSQL Database
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ======================
# VECTOR DATABASE
# ======================
VECTOR_DB_PATH=./data/chroma_db
COLLECTION_NAME=pdf_documents

# Processing Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ======================
# REDIS CONFIGURATION
# ======================
# Redis Cloud (for rate limiting & caching) - FREE 30MB tier
# Get from: https://redis.com/try-free/
# Format: redis://username:password@host:port
# Example: redis://default:abc123@redis-12207.c264.ap-south-1-1.ec2.cloud.redislabs.com:12207
REDIS_URL=redis://default:your_password@redis-12207.c264.ap-south-1-1.ec2.cloud.redislabs.com:12207

# Upstash Redis REST (for caching only - not compatible with rate limiting)
# Get from: https://upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Local Redis (Development - Optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Cache Settings
QUERY_CACHE_TTL=3600
SESSION_TTL=86400
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=3600

# ======================
# TEXT-TO-SPEECH SETTINGS
# ======================
# Speech speed: 1.0 = normal, 1.25 = 25% faster (recommended), 1.5 = 50% faster, 2.0 = double speed
TTS_SPEED_MULTIPLIER=1.75

# Azure Neural TTS (Optional - Premium quality, 5M characters/month free)
# Get from: https://portal.azure.com (Cognitive Services - Speech)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ======================
# MONITORING & ERROR TRACKING
# ======================
# Sentry (Error Tracking) - Free tier: 5K errors/month
# Get from: https://sentry.io/signup/
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development

# PostHog (Analytics) - Free tier: 1M events/month
# Get from: https://posthog.com/signup
POSTHOG_API_KEY=your_posthog_api_key_here

# ======================
# EMAIL SERVICE
# ======================
# Resend (Email Service) - Free tier: 3,000 emails/month
# Get from: https://resend.com/signup
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# ======================
# FRONTEND CONFIGURATION
# ======================
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ======================
# SECURITY
# ======================
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development

# ======================
# SERVER CONFIGURATION
# ======================
PORT=8080
